DATABASE_URL=postgresql+asyncpg://editflow:editflow@localhost:5432/editflow

# local (default) or s3
EDITFLOW_STORAGE_BACKEND=local
EDITFLOW_STORAGE_ROOT=/var/lib/editflow

# Required only when EDITFLOW_STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional timestamped evidence extraction providers (worker only)
# Without these keys, FFmpeg still extracts representative frames/audio;
# semantic vision analysis and speech transcription remain explicitly disabled.
EDITFLOW_ASR_API_KEY=
EDITFLOW_ASR_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
EDITFLOW_ASR_MODEL=whisper-1

EDITFLOW_VISION_API_KEY=
EDITFLOW_VISION_ENDPOINT=https://api.openai.com/v1/chat/completions
EDITFLOW_VISION_MODEL=gpt-4o-mini

EDITFLOW_EVIDENCE_TIMEOUT_SECONDS=900
